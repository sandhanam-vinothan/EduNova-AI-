# EduNova AI - Ollama Cloud only (configure values in Render Environment)
OLLAMA_API_KEY=replace_with_your_ollama_cloud_api_key
# Use a model returned by https://ollama.com/api/tags
OLLAMA_MODEL=gemma4:31b
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SESSION_SECRET=replace_with_long_random_secret
# No local Ollama, Gemini or OpenAI settings are required.
